# Names only. Supply real values using private deployment secret management.
# Never copy production keys, tokens or customer data into this example or Git.
MONGO_URL=
DB_NAME=
JWT_SECRET=
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VAR=
ENROLLMENT_INTEGRATION_KEY=
STAFF_SERVICE_KEY=
# Default owner administrator (one Indian mobile number). At every startup the single record carrying this phone
# is admin: promoted on the same canonical record (history kept, sessions revoked once) or created when missing.
# Sign-in stays the normal MSG91 OTP flow on the app and the website's staff exchange. Never a password or fixed OTP.
OWNER_ADMIN_PHONE=
# Separate database for isolated App Store / Play store-review accounts; MUST differ from DB_NAME and the
# deployment's MongoDB user must hold readWrite on it. Absent/placeholder => reviewer login answers 503 and never
# touches production data. Named but NOT authorised/reachable => the app still starts; review is reported unusable
# (/api/health flows.review.issues=[REVIEW_DB_UNAUTHORIZED]) and reviewer login answers 503.
REVIEW_DB_NAME=
EMERGENT_LLM_KEY=
CORS_ORIGINS=
BUILD_COMMIT=
PDF_MAX_BYTES=67108864
PDF_MAX_PAGES=200
# Application safeguards for NEW tracked writes only; NOT provider entitlement.
MEDIA_WRITE_BUDGET_BYTES=2000000000
MEDIA_WRITE_OBJECT_LIMIT=10000
# Optional object-store proxy origin, no credentials in its URL.
INTEGRATION_PROXY_URL=
# Optional overrides: MSG91_BASE_URL, MSG91_VALIDATE_URL, PDF_WORK_DIR.
# Preserve existing managed-object-storage credentials/configuration privately.