{
  "expo": {
    "name": "Yash Trade App",
    "slug": "yash-trade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yash-trade",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.yashtryontest.lt5e6b",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "icon": "./assets/images/icon-android-legacy.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#013625"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.yashtryontest.lt5e6b"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon-android-legacy.png",
          "color": "#013625",
          "defaultChannel": "operational",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/withNSEDevelopmentTeam.js",
      [
        "expo-rich-notifications",
        {
          "enableCommunicationNotifications": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "productionBackendUrl": "https://yash-tryon-test.emergent.host"
    }
  }
}
