# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
/build
dist/

# Environment files (.env) are deployment inputs for the Emergent pipeline and are intentionally NOT ignored.
# Never put real secrets in a *.example file; backend/.env values are provisioned per deployment.
*token.json*
*credentials.json*

# Logs and debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/

# Deployment
.vercel

# Archive files and large assets
**/*.zip
# Owner-approved release deliverable for the website team (rebuilt by backend/tools/build_release_handoff.py; no secrets inside)
!/WEBSITE_RELEASE_HANDOFF.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/

# Metro bundler cache
frontend/.metro-cache/
credentials.json
*.key
.credentials
private/
identity-exports/
migration-reports/
# Private reviewer-credential notes written by tools/provision_review_access.py (any folder, any name containing
# "review-access" with a .txt/.log/.bak extension). The app screen frontend/app/review-access.tsx IS source code and is tracked.
*review-access*.txt
*review-access*.log
*review-access*.bak
!frontend/app/review-access.tsx
backend/import-tmp/
!backend/.env.example
/memory/test_credentials.md
/backups/
/review-credentials/

# Owner operator virtualenv (Windows/macOS/Linux) - never committed
backend/.operator-venv/
.env
.env.*
*.env
